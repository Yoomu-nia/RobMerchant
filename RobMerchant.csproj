<Project Sdk="Godot.NET.Sdk/4.5.1">
	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<ImplicitUsings>true</ImplicitUsings>
		<LangVersion>13.0</LangVersion>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<!-- 游戏目录：只作为引用来源，不会写入 -->
		<Sts2Dir>D:\Steam\steamapps\common\Slay the Spire 2</Sts2Dir>
		<Sts2DataDir>$(Sts2Dir)\data_sts2_windows_x86_64</Sts2DataDir>

		<!-- RitsuLib 兼容版路径，版本号要与游戏版本一致 -->
		<RitsuLibDir>$(Sts2Dir)\..\..\workshop\content\2868840\3747602295\compat\0.111.0</RitsuLibDir>

		<!-- 构建产物默认拷到游戏的 mods 目录；可用 -p:ModsOutDir=... 改到别处 -->
		<ModsOutDir Condition="'$(ModsOutDir)' == ''">$(Sts2Dir)\mods</ModsOutDir>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="sts2">
			<HintPath>$(Sts2DataDir)\sts2.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<Reference Include="0Harmony">
			<HintPath>$(Sts2DataDir)\0Harmony.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<Reference Include="STS2-RitsuLib">
			<HintPath>$(RitsuLibDir)\STS2-RitsuLib.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<Reference Include="STS2-RitsuLib.Runtime">
			<HintPath>$(RitsuLibDir)\STS2-RitsuLib.Runtime.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<!-- 构建完成后复制 dll + json 到 mods\RobMerchant -->
	<Target Name="Copy Mod" AfterTargets="PostBuildEvent">
		<Message Text="Copying RobMerchant to $(ModsOutDir)\$(MSBuildProjectName)" Importance="high" />
		<MakeDir Directories="$(ModsOutDir)\$(MSBuildProjectName)" />
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModsOutDir)\$(MSBuildProjectName)" />
		<Copy SourceFiles="$(MSBuildProjectName).json" DestinationFolder="$(ModsOutDir)\$(MSBuildProjectName)" />
	</Target>
</Project>
